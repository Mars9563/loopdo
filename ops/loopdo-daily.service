[Unit]
Description=LoopDo daily keep-alive + Supabase dump (see /usr/local/sbin/loopdo-daily)
Wants=network-online.target
After=network-online.target docker.service
# A hang (killed by the timeout) or a crash before the script's own alerts → alert anyway.
OnFailure=loopdo-daily-failed.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/loopdo-daily
TimeoutStartSec=30min
# Exit 2 = a step failed and the script already sent its own alert.
SuccessExitStatus=2
